---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPosts, formatDate, shardStyles } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl pb-16">
    <a
      href="/blog"
      class="shard-4 mb-10 inline-block bg-green px-6 py-2 font-marker text-lg text-ink no-underline motion-safe:hover:animate-shake focus-visible:crayon-underline"
    >← Back to Blog</a>

    <header class="mb-10">
      <h1 class="mb-4 font-marker text-[clamp(2rem,6vw,3rem)] leading-tight">{post.data.title}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.tags.map((tag, i) => (
          <span class:list={[shardStyles[i % shardStyles.length], 'px-3 py-1']}>#{tag}</span>
        ))}
      </div>
    </header>

    <div class="prose prose-neutral max-w-none break-words sm:prose-lg
      prose-headings:font-marker prose-headings:font-normal
      prose-a:no-underline prose-a:crayon-underline hover:prose-a:bg-pink/40
      prose-blockquote:border-l-4 prose-blockquote:border-orange prose-blockquote:font-normal prose-blockquote:not-italic
      [&_blockquote_p]:before:content-none [&_blockquote_p]:after:content-none
      prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
      [&_:not(pre)>code]:rounded [&_:not(pre)>code]:bg-pink/40 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5
      prose-pre:rounded-none prose-pre:border-l-8 prose-pre:border-blue
      prose-img:border-crayon
      [&_ul>li]:relative [&_ul>li]:list-none [&_ul>li]:before:absolute [&_ul>li]:before:top-[0.75em] [&_ul>li]:before:-left-5 [&_ul>li]:before:size-2.5 [&_ul>li]:before:bg-ink [&_ul>li]:before:crayon-dot
      prose-li:marker:text-ink"
    >
      <Content />
    </div>
  </article>
</Layout>
